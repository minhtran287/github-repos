show_rules = False




def is_mouse_in_button(button):

    mouse_x, mouse_y = pygame.mouse.get_pos()

    return (
        mouse_x >= button["x"]
        and mouse_x < button["x"] + button["width"]
        and mouse_y >= button["y"]
        and mouse_y < button["y"] + button["height"]
    )


def on_mouse_up():
    global round_over
    global show_rules

    # Rules button
    if is_mouse_in_button(button_rules):
        show_rules = not show_rules
        return

    # Don't allow Hit or Stand while rules are open
    if show_rules:
        return

    if not round_over:

        if is_mouse_in_button(button_hit):

            take_card(player_hand)

            if get_total(player_hand) >= 21:
                round_over = True

        elif is_mouse_in_button(button_stand):
            round_over = True

        if round_over:
            while get_total(dealer_hand) < 17:
                take_card(dealer_hand)

    elif is_mouse_in_button(button_play_again):
        reset()




def has_hand_won(this_hand, other_hand):

    return (
        get_total(this_hand) <= 21
        and (
            get_total(other_hand) > 21
            or get_total(this_hand) > get_total(other_hand)
        )
    )




def draw_button(button):

    if is_mouse_in_button(button):
        color = (255, 202, 75)
    else:
        color = (255, 127, 57)

    screen.draw.filled_rect(
        Rect(
            button["x"],
            button["y"],
            button["width"],
            button["height"]
        ),
        color=color
    )

    screen.draw.text(
        button["text"],
        (
            button["x"] + button["text_offset_x"],
            button["y"] + button["text_offset_y"]
        ),
        color=(0, 0, 0)
    )




def draw():


    screen.blit("pokerback", (0, 0))

    card_spacing = 60
    margin_x = 10



    for card_index, card in enumerate(dealer_hand):

        image = card["suit"] + "_" + str(card["rank"])

        if not round_over and card_index == 0:
            image = "card_face_down"

        screen.blit(
            image,
            (
                card_index * card_spacing + margin_x,
                30
            )
        )



    for card_index, card in enumerate(player_hand):

        image = card["suit"] + "_" + str(card["rank"])

        screen.blit(
            image,
            (
                card_index * card_spacing + margin_x,
                140
            )
        )



    if round_over:

        screen.draw.text(
            "Dealer total: " + str(get_total(dealer_hand)),
            (margin_x, 10),
            color="white"
        )

    else:

        screen.draw.text(
            "Dealer total: ?",
            (margin_x, 10),
            color="white"
        )

    screen.draw.text(
        "Your total: " + str(get_total(player_hand)),
        (margin_x, 120),
        color="white"
    )



    if round_over:

        if has_hand_won(player_hand, dealer_hand):
            message = "You win!"

        elif has_hand_won(dealer_hand, player_hand):
            message = "You lose!"

        else:
            message = "Draw"

        screen.draw.text(
            message,
            (margin_x, 268),
            color="white",
            fontsize=28
        )



    if not round_over:

        draw_button(button_hit)
        draw_button(button_stand)

    else:

        draw_button(button_play_again)



    draw_button(button_rules)



    if show_rules:

        screen.draw.filled_rect(
            Rect(40, 45, 340, 190),
            color=(255, 255, 255)
        )

