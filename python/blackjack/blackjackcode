            (60, 90),
            color="black",
            fontsize=22
        )

        screen.draw.text(
            "Hit: take another card",
            (60, 115),
            color="black",
            fontsize=22
        )

        screen.draw.text(
            "Stand: keep your cards",
            (60, 140),
            color="black",
            fontsize=22
        )

        screen.draw.text(
            "But if you get over 21, you lose!",
            (60, 165),
            color="black",
            fontsize=22
        )

        screen.draw.text(
                    "Try to get a higher score than the dealer.",
                    (60, 190),
                    color="black",
